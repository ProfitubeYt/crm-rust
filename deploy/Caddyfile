64.188.106.221.nip.io {
    encode zstd gzip

    # Web mini-app + API traffic
    @mini path /mini-app*
    reverse_proxy @mini backend:8000 {
        header_up X-System-Access {$SYSTEM_ACCESS_TOKEN}
    }

    @api path /api/*
    reverse_proxy @api backend:8000 {
        header_up X-System-Access {$SYSTEM_ACCESS_TOKEN}
    }

    reverse_proxy /health backend:8000

    # CRM administration panel: three static files. Its data comes from
    # /api/admin/* above, which authorises every call.
    @admin path /admin /admin/*
    reverse_proxy @admin backend:8000

    # Nothing else is served here: the interface is the desktop client.
    # Named by exclusion because Caddy runs `respond` before `reverse_proxy`.
    @unrouted not path /mini-app* /api/* /health /admin /admin/*
    respond @unrouted 404
}
